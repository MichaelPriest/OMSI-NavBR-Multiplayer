<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>

    <DnneGenerateExports>true</DnneGenerateExports>
    <DnneBuildExports>true</DnneBuildExports>
    <DnneRuntimeIdentifier>win-x86</DnneRuntimeIdentifier>
    <DnneNativeBinaryName>NavBR.OmsiPlugin</DnneNativeBinaryName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DNNE" Version="2.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NavBR.OmsiPlugin.opl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
