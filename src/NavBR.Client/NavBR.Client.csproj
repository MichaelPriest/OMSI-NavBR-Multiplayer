<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>true</UseAppHost>
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>NavBR.Client</RootNamespace>
    <AssemblyName>OMSI.NavBR.Multiplayer</AssemblyName>
    <ApplicationIcon>Assets\NavBR.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\NavBR.ico" />
    <EmbeddedResource Include="Assets\NavBR.OmsiPlugin.bundle.zip"
                      LogicalName="NavBR.Client.Assets.NavBROmsiPlugin.bundle.zip"
                      Condition="Exists('Assets\NavBR.OmsiPlugin.bundle.zip')" />
    <ProjectReference Include="..\NavBR.Shared\NavBR.Shared.csproj" />
    <ProjectReference Include="..\NavBR.Server\NavBR.Server.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="WebUI\bootstrap\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\ui\navbr-web\dist\**\*"
             Link="WebUI\dist\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('..\..\ui\navbr-web\dist')" />
    <Content Include="..\..\mobile\navbr-mobile\dist\**\*"
             Link="MobileUI\dist\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('..\..\mobile\navbr-mobile\dist')" />
  </ItemGroup>

  <Target Name="ValidateNavBRXamlColors" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\validate-xaml-colors.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

  <Target Name="RepairNavBRIcon" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\repair-navbr-icon.ps1&quot; -Path &quot;$(MSBuildProjectDirectory)\Assets\NavBR.ico&quot;" />
  </Target>
</Project>
