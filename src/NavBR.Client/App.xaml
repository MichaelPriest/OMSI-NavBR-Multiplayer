<Application x:Class="NavBR.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="NavBgBrush" Color="#06101A" />
        <SolidColorBrush x:Key="NavSurfaceBrush" Color="#0A131A" />
        <SolidColorBrush x:Key="NavSurface2Brush" Color="#0D1A24" />
        <SolidColorBrush x:Key="NavControlBrush" Color="#0D1A24" />
        <SolidColorBrush x:Key="NavControlHoverBrush" Color="#102638" />
        <SolidColorBrush x:Key="NavControlPressedBrush" Color="#15354E" />
        <SolidColorBrush x:Key="NavBorderBrush" Color="#1C2A33" />
        <SolidColorBrush x:Key="NavTextBrush" Color="#DAE6EE" />
        <SolidColorBrush x:Key="NavMutedBrush" Color="#97ABB9" />
        <SolidColorBrush x:Key="NavDisabledBrush" Color="#60758A" />
        <SolidColorBrush x:Key="NavAccentBrush" Color="#3D89C4" />
        <SolidColorBrush x:Key="NavAccentBlueBrush" Color="#71C6FF" />
        <SolidColorBrush x:Key="NavSelectionBrush" Color="#102638" />

        <!--
            WPF control templates still reference SystemColors in several places.
            Override the relevant brushes so Windows light/dark mode cannot create
            white-on-white or black-on-dark combinations inside NavBR controls.
        -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#06101A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#DAE6EE" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0D1A24" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#DAE6EE" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#102638" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#60758A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#1C2A33" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource NavBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource NavControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource NavTextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource NavSelectionBrush}" />
            <Setter Property="SelectionTextBrush" Value="White" />
            <Setter Property="Padding" Value="9,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource NavControlBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource NavSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavSelectionBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0A131A" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavSelectionBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0F2434" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource NavDisabledBrush}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#0F2434" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavSelectionBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource NavAccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource NavDisabledBrush}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource NavSurface2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource NavSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
        </Style>

        <Style x:Key="NavPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource NavAccentBrush}" />
            <Setter Property="Foreground" Value="#04130C" />
            <Setter Property="BorderBrush" Value="{StaticResource NavAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NavCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NavSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="NavMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NavMutedBrush}" />
        </Style>

        <Style x:Key="NavSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
        </Style>
    </Application.Resources>
</Application>
