<Application x:Class="NavBR.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="NavBgBrush" Color="#07111F" />
        <SolidColorBrush x:Key="NavSurfaceBrush" Color="#0B1828" />
        <SolidColorBrush x:Key="NavSurface2Brush" Color="#10243A" />
        <SolidColorBrush x:Key="NavBorderBrush" Color="#24415F" />
        <SolidColorBrush x:Key="NavTextBrush" Color="#EEF7FF" />
        <SolidColorBrush x:Key="NavMutedBrush" Color="#9CB2C8" />
        <SolidColorBrush x:Key="NavAccentBrush" Color="#22C77A" />
        <SolidColorBrush x:Key="NavAccentBlueBrush" Color="#2AA8FF" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource NavBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E2034" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource NavTextBrush}" />
            <Setter Property="Padding" Value="9,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0E2034" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#091521" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#142A42" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#142A42" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="NavPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource NavAccentBrush}" />
            <Setter Property="Foreground" Value="#04130C" />
            <Setter Property="BorderBrush" Value="{StaticResource NavAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NavCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NavSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="NavMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NavMutedBrush}" />
        </Style>

        <Style x:Key="NavSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
        </Style>
    </Application.Resources>
</Application>
