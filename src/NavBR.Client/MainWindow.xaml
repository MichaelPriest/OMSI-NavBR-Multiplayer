<Window x:Class="NavBR.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMSI NavBR Multiplayer" Height="820" Width="920"
        MinHeight="650" MinWidth="760"
        Icon="Assets/NavBR.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="Assets/NavBR.ico" Width="54" Height="54" Margin="0,0,14,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="OMSI NavBR Multiplayer" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaglineText" Margin="0,4,0,0" Opacity="0.7" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock x:Name="LanguageLabelText" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="LanguageComboBox"
                              Width="170"
                              SelectionChanged="LanguageComboBox_SelectionChanged" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,24,0,16" Padding="16" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StatusHeadingText" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText" Margin="0,6,0,0" />
                        <TextBlock x:Name="InstallPathText" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.7" />
                    </StackPanel>
                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            Padding="14,8"
                            Margin="16,0,0,0"
                            Click="RefreshButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="TelemetryHeadingText" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="TelemetryStateText" Margin="0,6,0,14" Opacity="0.7" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="MapCaptionText" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,10" />
                        <TextBlock x:Name="MapValueText" Grid.Row="0" Grid.Column="1" Margin="0,0,24,10" TextWrapping="Wrap" />

                        <TextBlock x:Name="SpeedCaptionText" Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Margin="0,0,8,10" />
                        <TextBlock x:Name="SpeedValueText" Grid.Row="0" Grid.Column="3" Margin="0,0,0,10" />

                        <TextBlock x:Name="PositionCaptionText" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock x:Name="PositionValueText" Grid.Row="1" Grid.Column="1" Margin="0,0,24,0" FontFamily="Consolas" />

                        <TextBlock x:Name="HeadingCaptionText" Grid.Row="1" Grid.Column="2" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock x:Name="HeadingValueText" Grid.Row="1" Grid.Column="3" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="0,16,0,0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="GpsHeadingText" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="GpsStatusText" Margin="0,6,0,10" Opacity="0.7" TextWrapping="Wrap" />

                    <Border BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" Padding="4">
                        <Viewbox x:Name="RoadmapViewbox"
                                 Height="300"
                                 Stretch="Uniform"
                                 Visibility="Collapsed">
                            <Canvas x:Name="RoadmapCanvas" ClipToBounds="True">
                                <Image x:Name="RoadmapImage"
                                       Canvas.Left="0"
                                       Canvas.Top="0"
                                       Stretch="Fill" />
                                <Ellipse x:Name="VehicleMarker"
                                         Width="48"
                                         Height="48"
                                         Fill="#FFFF8C00"
                                         Stroke="White"
                                         StrokeThickness="8"
                                         Visibility="Collapsed" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock x:Name="InstalledMapsText" FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Margin="0,16,0,0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="MilestoneHeadingText" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="MilestoneBodyText" Margin="0,8,0,12" TextWrapping="Wrap" Opacity="0.7" />
                    <Separator Margin="0,0,0,12" />
                    <TextBlock x:Name="ProcessDetailsText" FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="PhaseFooterText" Grid.Row="5" Margin="0,16,0,0" Opacity="0.6" />
        </Grid>
    </ScrollViewer>
</Window>
