<Window x:Class="NavBR.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMSI NavBR Multiplayer"
        Height="820" Width="1180"
        MinHeight="680" MinWidth="900"
        Icon="Assets/NavBR.ico"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="64" Height="64"
                        Background="#10243A"
                        BorderBrush="{StaticResource NavBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="7"
                        Margin="0,0,16,0">
                    <Image Source="Assets/NavBR.ico" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="OMSI NavBR Multiplayer"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NavTextBrush}" />
                    <TextBlock x:Name="TaglineText"
                               Margin="0,5,0,0"
                               Style="{StaticResource NavMutedText}"
                               FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock x:Name="LanguageLabelText"
                                   Margin="2,0,0,4"
                                   FontSize="11"
                                   Foreground="{StaticResource NavMutedBrush}" />
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="168"
                                  SelectionChanged="LanguageComboBox_SelectionChanged" />
                    </StackPanel>
                    <Button x:Name="MultiplayerButton"
                            MinWidth="160"
                            Style="{StaticResource NavPrimaryButton}"
                            Loaded="MultiplayerButton_Loaded"
                            Click="MultiplayerButton_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,22,0,16"
                    Style="{StaticResource NavCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42"
                            Background="#133652"
                            CornerRadius="11"
                            Margin="0,0,14,0">
                        <TextBlock Text="●"
                                   Foreground="{StaticResource NavAccentBrush}"
                                   FontSize="19"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusHeadingText"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,3,0,0"
                                   FontSize="14" />
                        <TextBlock x:Name="InstallPathText"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Style="{StaticResource NavMutedText}" />
                    </StackPanel>
                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            MinWidth="118"
                            Margin="16,0,0,0"
                            Click="RefreshButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource NavCard}">
                        <StackPanel>
                            <TextBlock x:Name="TelemetryHeadingText"
                                       Style="{StaticResource NavSectionTitle}" />
                            <TextBlock x:Name="TelemetryStateText"
                                       Margin="0,5,0,16"
                                       Style="{StaticResource NavMutedText}"
                                       TextWrapping="Wrap" />

                            <Border Background="#091521" CornerRadius="9" Padding="12" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="MapCaptionText" FontSize="11" Foreground="{StaticResource NavMutedBrush}" />
                                        <TextBlock x:Name="MapValueText" Margin="0,3,8,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="SpeedCaptionText" FontSize="11" Foreground="{StaticResource NavMutedBrush}" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="SpeedValueText" Margin="8,3,0,0" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#091521" CornerRadius="9" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="PositionCaptionText" FontSize="11" Foreground="{StaticResource NavMutedBrush}" />
                                        <TextBlock x:Name="PositionValueText" Margin="0,3,8,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="HeadingCaptionText" FontSize="11" Foreground="{StaticResource NavMutedBrush}" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="HeadingValueText" Margin="8,3,0,0" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{StaticResource NavCard}">
                        <StackPanel>
                            <TextBlock x:Name="MilestoneHeadingText" Style="{StaticResource NavSectionTitle}" />
                            <TextBlock x:Name="MilestoneBodyText"
                                       Margin="0,7,0,14"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource NavMutedText}" />
                            <Border Height="1" Background="{StaticResource NavBorderBrush}" Margin="0,0,0,14" />
                            <TextBlock x:Name="ProcessDetailsText"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="#BCD1E5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource NavCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="GpsHeadingText" Style="{StaticResource NavSectionTitle}" />
                                <TextBlock x:Name="GpsStatusText"
                                           Margin="0,5,12,0"
                                           Style="{StaticResource NavMutedText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button x:Name="ZoomOutButton" Margin="5,0,0,0" Click="ZoomOutButton_Click" />
                                <Button x:Name="ZoomInButton" Margin="5,0,0,0" Click="ZoomInButton_Click" />
                                <Button x:Name="FitMapButton" Margin="5,0,0,0" Click="FitMapButton_Click" />
                                <ToggleButton x:Name="FollowButton" Margin="5,0,0,0" IsChecked="True"
                                              Checked="FollowButton_Changed" Unchecked="FollowButton_Changed" />
                                <ToggleButton x:Name="TopmostButton" Margin="5,0,0,0"
                                              Checked="TopmostButton_Changed" Unchecked="TopmostButton_Changed" />
                            </WrapPanel>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{StaticResource NavBorderBrush}" Margin="0,16,0,14" />

                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource NavBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Background="#050C14"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="RoadmapScrollViewer"
                                          Height="480"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="Collapsed"
                                          PreviewMouseWheel="RoadmapScrollViewer_PreviewMouseWheel"
                                          PreviewMouseLeftButtonDown="RoadmapScrollViewer_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="RoadmapScrollViewer_PreviewMouseMove"
                                          PreviewMouseLeftButtonUp="RoadmapScrollViewer_PreviewMouseLeftButtonUp">
                                <Viewbox x:Name="RoadmapViewbox"
                                         Stretch="Fill"
                                         StretchDirection="Both"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top">
                                    <Canvas x:Name="RoadmapCanvas" ClipToBounds="True">
                                        <Image x:Name="RoadmapImage"
                                               Canvas.Left="0"
                                               Canvas.Top="0"
                                               Stretch="Fill" />

                                        <Grid x:Name="VehicleMarker"
                                              Width="48"
                                              Height="48"
                                              RenderTransformOrigin="0.5,0.5"
                                              Visibility="Collapsed">
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="VehicleHeadingTransform" />
                                            </Grid.RenderTransform>
                                            <Ellipse Fill="#FFFF8C00" Stroke="White" StrokeThickness="4" />
                                            <Polygon Points="24,6 34,32 24,27 14,32"
                                                     Fill="White"
                                                     Stroke="#FF202020"
                                                     StrokeThickness="1" />
                                        </Grid>
                                    </Canvas>
                                </Viewbox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock x:Name="InstalledMapsText"
                                   Grid.Row="3"
                                   Margin="2,12,2,0"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource NavMutedBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock x:Name="PhaseFooterText"
                       Grid.Row="3"
                       Margin="2,16,2,2"
                       Style="{StaticResource NavMutedText}"
                       FontSize="11" />
        </Grid>
    </ScrollViewer>
</Window>
