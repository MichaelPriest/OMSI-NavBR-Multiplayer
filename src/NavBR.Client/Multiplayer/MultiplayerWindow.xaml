<Window x:Class="NavBR.Client.Multiplayer.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMSI NavBR Multiplayer"
        Height="800" Width="980"
        MinHeight="690" MinWidth="840"
        Icon="../Assets/NavBR.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeadingText" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,5,0,0"
                           Style="{StaticResource NavMutedText}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="#12324B"
                    BorderBrush="{StaticResource NavBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <TextBlock Text="PEER HOST • TCP 27730"
                           Foreground="{StaticResource NavAccentBrush}"
                           FontSize="11"
                           FontWeight="Bold" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource NavCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ServerLabelText" Grid.Row="0" Grid.Column="0" Margin="0,0,10,11" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="ServerTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,11" />

                <TextBlock x:Name="RoomLabelText" Grid.Row="1" Grid.Column="0" Margin="0,0,10,11" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="RoomTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,18,11" MaxLength="64" />

                <TextBlock x:Name="NicknameLabelText" Grid.Row="1" Grid.Column="2" Margin="0,0,10,11" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="NicknameTextBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,11" MaxLength="32" />

                <TextBlock x:Name="LocalMapLabelText" Grid.Row="2" Grid.Column="0" Margin="0,0,10,11" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock x:Name="LocalMapValueText" Grid.Row="2" Grid.Column="1" Margin="0,0,18,11" VerticalAlignment="Center" TextWrapping="Wrap" />

                <CheckBox x:Name="VoiceEnabledCheckBox"
                          Grid.Row="2" Grid.Column="2"
                          Grid.ColumnSpan="2"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,0,11" />

                <TextBlock x:Name="ChatHotkeyLabelText"
                           Grid.Row="3" Grid.Column="0"
                           Margin="0,0,10,11"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <ComboBox x:Name="ChatHotkeyComboBox"
                          Grid.Row="3" Grid.Column="1"
                          Width="155"
                          HorizontalAlignment="Left"
                          Margin="0,0,18,11"
                          SelectionChanged="HotkeyComboBox_SelectionChanged" />

                <TextBlock x:Name="VoiceHotkeyLabelText"
                           Grid.Row="3" Grid.Column="2"
                           Margin="0,0,10,11"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="PTT" />
                <ComboBox x:Name="VoiceHotkeyComboBox"
                          Grid.Row="3" Grid.Column="3"
                          Width="155"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,11"
                          SelectionChanged="HotkeyComboBox_SelectionChanged" />

                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                        Background="#091521"
                        CornerRadius="9"
                        Padding="11"
                        Margin="0,1,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Windows Firewall" FontWeight="SemiBold" />
                            <TextBlock x:Name="FirewallStatusText"
                                       Margin="0,3,12,0"
                                       Style="{StaticResource NavMutedText}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="FirewallButton"
                                Grid.Column="1"
                                MinWidth="170"
                                Loaded="FirewallButton_Loaded"
                                Click="FirewallButton_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CreateRoomButton"
                            Grid.Column="0"
                            Style="{StaticResource NavPrimaryButton}"
                            Margin="0,0,8,0"
                            Click="CreateRoomButton_Click" />
                    <Button x:Name="ConnectButton"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Click="ConnectButton_Click" />
                    <Button x:Name="CopyInviteButton"
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Loaded="CopyInviteButton_Loaded"
                            Click="CopyInviteButton_Click" />
                    <Button x:Name="PasteInviteButton"
                            Grid.Column="3"
                            Margin="0,0,10,0"
                            Loaded="PasteInviteButton_Loaded"
                            Click="PasteInviteButton_Click" />
                    <TextBlock x:Name="InviteAddressText"
                               Grid.Column="4"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource NavMutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource NavCard}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#FF888888" VerticalAlignment="Center" Margin="0,0,11,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetailText" Margin="0,3,0,0" Style="{StaticResource NavMutedText}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="PlayerCountText" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource NavCard}" Padding="14">
                <DockPanel>
                    <TextBlock x:Name="PlayersHeadingText" DockPanel.Dock="Top" Style="{StaticResource NavSectionTitle}" Margin="0,0,0,10" />
                    <ListBox x:Name="PlayersListBox" FontFamily="Consolas" FontSize="12" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource NavCard}" Padding="14">
                <DockPanel>
                    <TextBlock x:Name="ChatHeadingText" DockPanel.Dock="Top" Style="{StaticResource NavSectionTitle}" Margin="0,0,0,10" />
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatTextBox"
                                 Grid.Column="0"
                                 MaxLength="280"
                                 KeyDown="ChatTextBox_KeyDown" />
                        <Button x:Name="SendChatButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource NavPrimaryButton}"
                                Click="SendChatButton_Click" />
                    </Grid>
                    <ListBox x:Name="ChatListBox" />
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterText"
                   Grid.Row="4"
                   Margin="2,14,2,0"
                   Style="{StaticResource NavMutedText}"
                   FontSize="11"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
