                            <Border Style="{StaticResource NavMultiplayerCard}">
                                <StackPanel>
                                    <TextBlock Text="REDE / NAT" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                    <TextBlock Text="UPnP e exposição da porta"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MpText}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />

                                    <CheckBox x:Name="UpnpEnabledCheckBox"
                                              Margin="0,13,0,0"
                                              FontWeight="SemiBold"
                                              Loaded="UpnpEnabledCheckBox_Loaded"
                                              Checked="UpnpEnabledCheckBox_Changed"
                                              Unchecked="UpnpEnabledCheckBox_Changed" />
                                    <TextBlock x:Name="UpnpDescriptionText"
                                               Margin="22,4,0,0"
                                               Foreground="#718A9B"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource NavMultiplayerCard}">
                                <StackPanel>
                                    <TextBlock Text="FIREWALL" Style="{StaticResource NavMultiplayerSectionLabel}" />
