<Window x:Class="NavBR.Client.Multiplayer.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMSI NavBR Multiplayer"
        Height="900" Width="1360"
        MinHeight="760" MinWidth="1120"
        Icon="../Assets/NavBR.ico"
        Background="#06101A"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="MpBackground" Color="#06101A" />
        <SolidColorBrush x:Key="MpSidebar" Color="#07121B" />
        <SolidColorBrush x:Key="MpCard" Color="#0A131A" />
        <SolidColorBrush x:Key="MpElevated" Color="#0D1A24" />
        <SolidColorBrush x:Key="MpBorder" Color="#1C2A33" />
        <SolidColorBrush x:Key="MpBlue" Color="#3D89C4" />
        <SolidColorBrush x:Key="MpInteraction" Color="#71C6FF" />
        <SolidColorBrush x:Key="MpSuccess" Color="#38C98C" />
        <SolidColorBrush x:Key="MpWarning" Color="#F2B84B" />
        <SolidColorBrush x:Key="MpError" Color="#EF5B64" />
        <SolidColorBrush x:Key="MpText" Color="#DAE6EE" />
        <SolidColorBrush x:Key="MpMuted" Color="#97ABB9" />

        <Style x:Key="NavMultiplayerTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#7F96A7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#102638" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3D89C4" />
                                <Setter Property="Foreground" Value="#DAE6EE" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0D1A24" />
                                <Setter Property="Foreground" Value="#DAE6EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavMultiplayerCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MpCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource MpBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="17" />
        </Style>

        <Style x:Key="NavMultiplayerHeroCard" TargetType="Border" BasedOn="{StaticResource NavMultiplayerCard}">
            <Setter Property="Background" Value="#081722" />
            <Setter Property="BorderBrush" Value="#1C3B50" />
        </Style>

        <Style x:Key="NavMultiplayerSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MpInteraction}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="NavMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#668198" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="NavMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MpText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="NavInputLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EA4B3" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="NavSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F2434" />
            <Setter Property="BorderBrush" Value="#24465D" />
            <Setter Property="Foreground" Value="#C7D9E4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NavQuickButton" TargetType="Button" BasedOn="{StaticResource NavSecondaryButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
        </Style>

        <Style x:Key="NavKeycap" TargetType="Border">
            <Setter Property="Background" Value="#102333" />
            <Setter Property="BorderBrush" Value="#28455A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,0,7,7" />
        </Style>
    </Window.Resources>

    <Grid Margin="22" Background="{StaticResource MpBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CENTRAL MULTIPLAYER"
                           Foreground="{StaticResource MpInteraction}"
                           FontSize="10"
                           FontWeight="Bold" />
                <TextBlock x:Name="HeadingText"
                           Margin="0,3,0,0"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MpText}" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MpMuted}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Background="#0C2A20"
                        BorderBrush="#1F5B45"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="13,8"
                        Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="9"
                                 Height="9"
                                 Fill="#888888"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Foreground="#7BE0A7"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#0B2132"
                        BorderBrush="#23465F"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="13,8">
                    <TextBlock Text="TCP 27730 • NAVBR"
                               Foreground="{StaticResource MpInteraction}"
                               FontSize="10.5"
                               FontWeight="Bold" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Background="#081722"
                BorderBrush="#1B3445"
                BorderThickness="1"
                CornerRadius="14"
                Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="2" Padding="12,9" Background="#0B1D2A" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="SALA ATUAL" Style="{StaticResource NavMetricLabel}" />
                        <TextBlock x:Name="SessionRoomValueText" Text="—" Style="{StaticResource NavMetricValue}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="2" Padding="12,9" Background="#0B1D2A" CornerRadius="10">
                    <StackPanel>
                        <TextBlock x:Name="LocalMapLabelText" Text="MAPA LOCAL" Style="{StaticResource NavMetricLabel}" />
                        <TextBlock x:Name="LocalMapValueText" Text="—" Style="{StaticResource NavMetricValue}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="2" Padding="12,9" Background="#0B1D2A" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="JOGADORES" Style="{StaticResource NavMetricLabel}" />
                        <TextBlock x:Name="PlayerCountText" Text="0" Style="{StaticResource NavMetricValue}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Margin="2" Padding="12,9" Background="#0B1D2A" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="LATÊNCIA" Style="{StaticResource NavMetricLabel}" />
                        <TextBlock x:Name="LatencyValueText" Text="—" Style="{StaticResource NavMetricValue}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Margin="2" Padding="12,9" Background="#0B1D2A" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="HOST" Style="{StaticResource NavMetricLabel}" />
                        <TextBlock x:Name="HostStateValueText" Text="Local inativo" Style="{StaticResource NavMetricValue}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="MultiplayerTabs"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectedIndex="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource NavMultiplayerTabItem}" />
            </TabControl.Resources>

            <TabItem x:Name="OverviewTab" Header="Visão geral">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.05*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource NavMultiplayerHeroCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mapa da sessão"
                                               Foreground="{StaticResource MpText}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Ônibus e personagens aparecem somente quando a sessão fornece telemetria real e compatível."
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource MpMuted}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#0B2D22"
                                        BorderBrush="#1E5D46"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,6"
                                        VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#38C98C" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="SESSÃO AO VIVO"
                                                   Foreground="#6FDE9F"
                                                   FontSize="9"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="0,14,0,14"
                                    MinHeight="405"
                                    Background="#050F18"
                                    BorderBrush="#18384D"
                                    BorderThickness="1"
                                    CornerRadius="13"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Canvas x:Name="LiveSessionCanvas"
                                            Grid.Row="0"
                                            Margin="13"
                                            ClipToBounds="True" />
                                    <Border Grid.Row="1"
                                            Background="#081B28"
                                            BorderBrush="#173247"
                                            BorderThickness="0,1,0,0"
                                            Padding="12,9">
                                        <TextBlock x:Name="LiveSessionHintText"
                                                   Text="Aguardando telemetria real compatível da sessão."
                                                   Foreground="#728A9A"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ENDEREÇO / CONVITE" Style="{StaticResource NavMetricLabel}" />
                                    <TextBlock x:Name="InviteAddressText"
                                               Margin="0,4,16,0"
                                               VerticalAlignment="Center"
                                               Foreground="#A5B8C5"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="OverviewConnectionText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MpInteraction}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Text="Sessão desconectada" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.25*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource NavMultiplayerCard}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Jogadores próximos"
                                                   Foreground="{StaticResource MpText}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Estado operacional da sala"
                                                   Foreground="#718A9B"
                                                   FontSize="10"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="#102639"
                                            CornerRadius="8"
                                            Padding="8,4"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="LIVE" Foreground="#78BFFF" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <ListBox x:Name="PlayersOverviewListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         IsHitTestVisible="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,7"
                                                    Padding="10"
                                                    Background="#081722"
                                                    BorderBrush="#172B38"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource MpText}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Secondary}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="#718A9B"
                                                                   FontSize="9.5"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Padding="7,4"
                                                            Background="#102333"
                                                            CornerRadius="7"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Mode}"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   FontSize="9.5"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="ESTADO DA SESSÃO" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock x:Name="StatusDetailText"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource MpText}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="OverviewHostDetailText"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource MpMuted}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="ATALHOS" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <Button Content="Sala" Margin="0,0,5,5" Style="{StaticResource NavQuickButton}" Click="OpenRoomTab_Click" />
                                    <Button Content="Jogadores" Margin="5,0,0,5" Style="{StaticResource NavQuickButton}" Click="OpenPlayersTab_Click" />
                                    <Button Content="Chat &amp; Voz" Margin="0,5,5,0" Style="{StaticResource NavQuickButton}" Click="OpenChatTab_Click" />
                                    <Button Content="Personagem / RP" Margin="5,5,0,0" Style="{StaticResource NavQuickButton}" Click="OpenRoleplayTab_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="RoomTab" Header="Sala">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#081722"
                            BorderBrush="#1B3445"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="SALA" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock Text="Identificador"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource MpMuted}"
                                           FontSize="9.5" />
                            </StackPanel>

                            <TextBox x:Name="RoomTextBox"
                                     Grid.Column="1"
                                     MaxLength="64"
                                     VerticalContentAlignment="Center" />

                            <StackPanel Grid.Column="3"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="PERFIL" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock Text="Motorista"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource MpMuted}"
                                           FontSize="9.5" />
                            </StackPanel>

                            <TextBox x:Name="NicknameTextBox"
                                     Grid.Column="4"
                                     MaxLength="32"
                                     VerticalContentAlignment="Center" />

                            <StackPanel Grid.Column="6"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Background="#102333"
                                        CornerRadius="8"
                                        Padding="9,5"
                                        Margin="0,0,8,0">
                                    <TextBlock x:Name="RoomUpnpStateText"
                                               Text="UPnP: —"
                                               Foreground="{StaticResource MpMuted}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#0C2A20"
                                        BorderBrush="#1F5B45"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="9,5">
                                    <TextBlock Text="TCP 27730"
                                               Foreground="#75D9A0"
                                               FontSize="9.5"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="RoomLabelText"
                                       Grid.Column="1"
                                       Visibility="Collapsed"
                                       Text="Sala" />
                            <TextBlock x:Name="NicknameLabelText"
                                       Grid.Column="4"
                                       Visibility="Collapsed"
                                       Text="Motorista" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource NavMultiplayerHeroCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="CRIAR SALA" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                    <TextBlock Text="Hospedar uma nova sessão"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MpText}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Este computador será o host da sala. As opções técnicas ficam na aba Avançado."
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MpMuted}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Margin="0,16,0,0"
                                        Padding="12"
                                        Background="#0D1A24"
                                        BorderBrush="#1C2A33"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="PRIVACIDADE" Style="{StaticResource NavMetricLabel}" />
                                            <CheckBox x:Name="PrivateRoomCheckBox"
                                                      Margin="0,7,0,0"
                                                      FontWeight="SemiBold"
                                                      Loaded="PrivateRoomCheckBox_Loaded"
                                                      Checked="PrivateRoomCheckBox_Changed"
                                                      Unchecked="PrivateRoomCheckBox_Changed" />
                                        </StackPanel>
                                        <TextBlock x:Name="RoomPrivacyStateText"
                                                   Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Foreground="{StaticResource MpInteraction}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="180" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                    <TextBlock x:Name="RoomPasswordLabelText"
                                               Text="Senha da sala"
                                               Style="{StaticResource NavInputLabel}" />
                                    <PasswordBox x:Name="RoomPasswordBox"
                                                 MaxLength="128"
                                                 Padding="10,8"
                                                 PasswordChanged="RoomPasswordBox_PasswordChanged" />
                                    <TextBlock x:Name="RoomPasswordHintText"
                                               Margin="0,5,0,0"
                                               Foreground="#718A9B"
                                               FontSize="9.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="3"
                                        Margin="0,14,0,0"
                                        Padding="12"
                                        Background="#081722"
                                        BorderBrush="#172B38"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Text="COMO FUNCIONA" Style="{StaticResource NavMetricLabel}" />
                                        <TextBlock x:Name="RoomPrivacyDescriptionText"
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource MpMuted}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="4" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CreateRoomButton"
                                            MinHeight="42"
                                            Style="{StaticResource NavPrimaryButton}"
                                            PreviewMouseLeftButtonDown="CreateRoomButton_PrivacyPreviewMouseLeftButtonDown"
                                            PreviewKeyDown="CreateRoomButton_PrivacyPreviewKeyDown"
                                            Click="CreateRoomButton_Click" />
                                    <Button x:Name="CopyInviteButton"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            MinWidth="116"
                                            Style="{StaticResource NavSecondaryButton}"
