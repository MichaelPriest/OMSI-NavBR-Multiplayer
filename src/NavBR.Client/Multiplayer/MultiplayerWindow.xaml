                                            Margin="0,16,0,0" />

                                <Border Grid.Row="3"
                                        Margin="0,16,0,0"
                                        Padding="12"
                                        Background="#081722"
                                        BorderBrush="#172B38"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <TextBlock Text="O modo a pé permanece experimental. Nenhum personagem é criado a partir de dados fictícios: sem Drivers, telemetria ou capacidade do plugin, a ação fica indisponível."
                                               Foreground="#879EAD"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource NavMultiplayerCard}">
                                <StackPanel>
                                    <TextBlock Text="CAPACIDADE RP" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                    <TextBlock x:Name="RoleplayPluginStatusText"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource MpText}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="PLUGIN / BRIDGE"
                                               Margin="0,13,0,0"
                                               Style="{StaticResource NavMetricLabel}" />
                                    <TextBlock x:Name="RoleplaySyncStatusText"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource MpMuted}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource NavMultiplayerCard}">
                                <StackPanel>
                                    <TextBlock Text="CONTROLES" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                    <WrapPanel Margin="0,11,0,0">
                                        <Border Style="{StaticResource NavKeycap}"><TextBlock Text="W / S" Foreground="{StaticResource MpText}" FontWeight="SemiBold" /></Border>
                                        <Border Style="{StaticResource NavKeycap}"><TextBlock Text="A / D" Foreground="{StaticResource MpText}" FontWeight="SemiBold" /></Border>
                                        <Border Style="{StaticResource NavKeycap}"><TextBlock Text="SHIFT" Foreground="{StaticResource MpText}" FontWeight="SemiBold" /></Border>
                                        <Border Style="{StaticResource NavKeycap}"><TextBlock Text="ESC" Foreground="{StaticResource MpText}" FontWeight="SemiBold" /></Border>
                                    </WrapPanel>
                                    <TextBlock Text="W/S andar • A/D girar • Shift correr • Esc voltar ao ônibus"
                                               Foreground="#8DA4B3"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource NavMultiplayerCard}">
                                <StackPanel>
                                    <TextBlock Text="SINCRONIZAÇÃO" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                    <TextBlock Text="Quando conectado, o mesmo estado global do personagem é publicado para a sala. Sem multiplayer, o RP continua funcionando localmente."
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource MpMuted}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AdvancedTab" Header="Avançado">
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource NavMultiplayerCard}">
                                <StackPanel>
                                    <TextBlock Text="EXPERIMENTAL / DIAGNÓSTICO" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                    <TextBlock Text="Ônibus físico e diagnósticos"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MpText}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Recursos técnicos que escrevem no OMSI continuam opt-in e dependem das capacidades reais anunciadas pelo plugin."
                                               Margin="0,5,0,14"
                                               Foreground="{StaticResource MpMuted}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                    <StackPanel x:Name="ExperimentalOptionsHost" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Style="{StaticResource NavMultiplayerCard}">
                                <StackPanel>
                                    <TextBlock Text="BRIDGE / PLUGIN" Style="{StaticResource NavMultiplayerSectionLabel}" />
