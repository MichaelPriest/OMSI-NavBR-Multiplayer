                                               Foreground="{StaticResource MpMuted}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Margin="0,16,0,0"
                                        Padding="14"
                                        Background="#0D1A24"
                                        BorderBrush="#254358"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ESTADO ATUAL" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                            <TextBlock x:Name="RoleplayStateText"
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource MpText}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="RoleplayActionButton"
