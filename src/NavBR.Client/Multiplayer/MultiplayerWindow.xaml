<Window x:Class="NavBR.Client.Multiplayer.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMSI NavBR Multiplayer"
        Height="780" Width="900"
        MinHeight="650" MinWidth="780"
        Icon="../Assets/NavBR.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="DescriptionText" Margin="0,5,0,0" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Padding="16" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ServerLabelText" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="ServerTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,10" Padding="7,5" />

                <TextBlock x:Name="RoomLabelText" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="RoomTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,18,10" Padding="7,5" MaxLength="64" />

                <TextBlock x:Name="NicknameLabelText" Grid.Row="1" Grid.Column="2" Margin="0,0,10,10" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="NicknameTextBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" Padding="7,5" MaxLength="32" />

                <TextBlock x:Name="LocalMapLabelText" Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock x:Name="LocalMapValueText" Grid.Row="2" Grid.Column="1" Margin="0,0,18,10" VerticalAlignment="Center" TextWrapping="Wrap" />

                <CheckBox x:Name="VoiceEnabledCheckBox"
                          Grid.Row="2" Grid.Column="2"
                          Grid.ColumnSpan="2"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,0,10" />

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                    <Button x:Name="CreateRoomButton"
                            Padding="18,8"
                            Margin="0,0,8,0"
                            Click="CreateRoomButton_Click" />
                    <Button x:Name="ConnectButton"
                            Padding="18,8"
                            Margin="0,0,8,0"
                            Click="ConnectButton_Click" />
                    <Button x:Name="CopyInviteButton"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Loaded="CopyInviteButton_Loaded"
                            Click="CopyInviteButton_Click" />
                    <Button x:Name="PasteInviteButton"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Loaded="PasteInviteButton_Loaded"
                            Click="PasteInviteButton_Click" />
                    <TextBlock x:Name="InviteAddressText"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Opacity="0.72"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="14" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#FF888888" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetailText" Margin="0,3,0,0" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="PlayerCountText" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="14" BorderThickness="1" CornerRadius="8" Margin="0,0,7,0">
                <DockPanel>
                    <TextBlock x:Name="PlayersHeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                    <ListBox x:Name="PlayersListBox" FontFamily="Consolas" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Padding="14" BorderThickness="1" CornerRadius="8" Margin="7,0,0,0">
                <DockPanel>
                    <TextBlock x:Name="ChatHeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatTextBox"
                                 Grid.Column="0"
                                 MaxLength="280"
                                 Padding="8,6"
                                 KeyDown="ChatTextBox_KeyDown" />
                        <Button x:Name="SendChatButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="14,6"
                                Click="SendChatButton_Click" />
                    </Grid>
                    <ListBox x:Name="ChatListBox" />
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterText" Grid.Row="4" Margin="0,14,0,0" Opacity="0.6" TextWrapping="Wrap" />
    </Grid>
</Window>
