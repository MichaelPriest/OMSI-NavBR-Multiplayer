                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="FooterText"
                                               Margin="0,8,0,0"
                                               Foreground="#718A9B"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
