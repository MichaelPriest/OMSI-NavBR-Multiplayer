                                            HorizontalAlignment="Left"
                                            MinWidth="180"
                                            Style="{StaticResource NavSecondaryButton}"
                                            Loaded="FirewallButton_Loaded"
                                            Click="FirewallButton_Click" />
                                </StackPanel>
                            </Border>
