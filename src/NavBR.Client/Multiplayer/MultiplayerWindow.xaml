<Window x:Class="NavBR.Client.Multiplayer.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMSI NavBR Multiplayer"
        Height="860" Width="1180"
        MinHeight="720" MinWidth="980"
        Icon="../Assets/NavBR.ico"
        Background="#06101A"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22" Background="#06101A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho operacional -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#F4F8FB" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,5,0,0"
                           Foreground="#8FA6B8"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#0C2A20"
                        BorderBrush="#1F5B45"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,7"
                        Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="9" Height="9"
                                 Fill="#FF888888"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Foreground="#7BE0A7"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Background="#0B2132"
                        BorderBrush="#23465F"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,7">
                    <TextBlock Text="CENTRAL MULTIPLAYER • TCP 27730"
                               Foreground="#68B9FF"
                               FontSize="10.5"
                               FontWeight="Bold" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Faixa da sessão atual -->
        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Background="#0A1824"
                BorderBrush="#1D3445"
                BorderThickness="1"
                CornerRadius="13"
                Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SESSÃO ATUAL"
                               Foreground="#668198"
                               FontSize="9"
                               FontWeight="Bold" />
                    <TextBlock x:Name="StatusDetailText"
                               Margin="0,4,14,0"
                               Foreground="#E6EEF4"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="MAPA LOCAL"
                               Foreground="#668198"
                               FontSize="9"
                               FontWeight="Bold" />
                    <TextBlock x:Name="LocalMapValueText"
                               Margin="0,4,14,0"
                               Foreground="#C6D4DE"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LocalMapLabelText"
                               Visibility="Collapsed" />
                </StackPanel>
                <Border Grid.Column="2"
                        Background="#102639"
                        CornerRadius="10"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerCountText"
                               Foreground="#F4F8FB"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <!-- Área principal: sessão/mapa, jogadores e chat -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1.15*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="0.85*" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0"
                    Background="#081722"
                    BorderBrush="#1C3446"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mapa da sessão"
                                       Foreground="#F3F7FA"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Visão operacional da sala e dos ônibus conectados"
                                       Margin="0,3,0,0"
                                       Foreground="#7891A5"
                                       FontSize="10.5" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="#0A2B20"
                                CornerRadius="9"
                                Padding="9,5"
                                VerticalAlignment="Center">
                            <TextBlock Text="AO VIVO"
                                       Foreground="#64D79A"
                                       FontSize="9"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,13,0,13"
                            Background="#06131E"
                            BorderBrush="#173247"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0" Margin="12">
                                <Ellipse Width="14" Height="14" Fill="#26D07C" Canvas.Left="68" Canvas.Top="72" />
                                <Ellipse Width="14" Height="14" Fill="#2E9FFF" Canvas.Left="188" Canvas.Top="116" />
                                <Ellipse Width="14" Height="14" Fill="#F2B84B" Canvas.Left="304" Canvas.Top="65" />
                                <Ellipse Width="14" Height="14" Fill="#E95A5A" Canvas.Left="390" Canvas.Top="146" />
                                <Polyline Points="38,160 118,124 206,142 288,98 370,120 454,68"
                                          Stroke="#1C5D89"
                                          StrokeThickness="4"
                                          StrokeLineJoin="Round" />
                                <Polyline Points="42,178 132,190 214,164 316,184 416,160"
                                          Stroke="#123A57"
                                          StrokeThickness="2"
                                          StrokeDashArray="3,4" />
                            </Canvas>
                            <Border Grid.Row="1"
                                    Background="#081C2A"
                                    CornerRadius="0,0,12,12"
                                    Padding="11,8">
                                <TextBlock Text="O mapa multiplayer será conectado à telemetria remota; a Central já usa este espaço operacional como área principal."
                                           Foreground="#6F899D"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InviteAddressText"
                                   VerticalAlignment="Center"
                                   Foreground="#8198AA"
                                   FontSize="10.5"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="CopyInviteButton"
                                    Margin="8,0,0,0"
                                    IsEnabled="False"
                                    Loaded="CopyInviteButton_Loaded"
                                    Click="CopyInviteButton_Click" />
                            <Button x:Name="PasteInviteButton"
                                    Margin="8,0,0,0"
                                    Loaded="PasteInviteButton_Loaded"
                                    Click="PasteInviteButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="3"
                    Background="#081722"
                    BorderBrush="#1C3446"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlayersHeadingText"
                                   Foreground="#F3F7FA"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <Border Grid.Column="1"
                                Background="#102639"
                                CornerRadius="8"
                                Padding="8,4">
                            <TextBlock Text="ONLINE"
                                       Foreground="#78BFFF"
                                       FontSize="9"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <ListBox x:Name="PlayersListBox"
                             FontFamily="Segoe UI"
                             FontSize="12"
                             Background="#06131E"
                             BorderThickness="0"
                             Padding="5" />
                </DockPanel>
            </Border>

            <Border Grid.Column="0" Grid.Row="2"
                    Background="#081722"
                    BorderBrush="#1C3446"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="14">
                <DockPanel>
                    <TextBlock x:Name="ChatHeadingText"
                               DockPanel.Dock="Top"
                               Foreground="#F3F7FA"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,9" />
                    <Grid DockPanel.Dock="Bottom" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatTextBox"
                                 Grid.Column="0"
                                 MaxLength="280"
                                 KeyDown="ChatTextBox_KeyDown" />
                        <Button x:Name="SendChatButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource NavPrimaryButton}"
                                Click="SendChatButton_Click" />
                    </Grid>
                    <ListBox x:Name="ChatListBox"
                             Background="#06131E"
                             BorderThickness="0" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Configuração rápida de sala -->
        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Background="#0A1824"
                BorderBrush="#1D3445"
                BorderThickness="1"
                CornerRadius="13"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RoomLabelText"
                           Grid.Column="0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="#91A8BA"
                           FontWeight="SemiBold" />
                <TextBox x:Name="RoomTextBox"
                         Grid.Column="1"
                         Margin="0,0,12,0"
                         MaxLength="64" />
                <TextBlock x:Name="NicknameLabelText"
                           Grid.Column="2"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="#91A8BA"
                           FontWeight="SemiBold" />
                <TextBox x:Name="NicknameTextBox"
                         Grid.Column="3"
                         Margin="0,0,12,0"
                         MaxLength="32" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="CreateRoomButton"
                            Style="{StaticResource NavPrimaryButton}"
                            Margin="0,0,8,0"
                            PreviewMouseLeftButtonDown="CreateRoomButton_PrivacyPreviewMouseLeftButtonDown"
                            PreviewKeyDown="CreateRoomButton_PrivacyPreviewKeyDown"
                            Click="CreateRoomButton_Click" />
                    <Button x:Name="ConnectButton"
                            PreviewMouseLeftButtonDown="ConnectButton_PrivacyPreviewMouseLeftButtonDown"
                            PreviewKeyDown="ConnectButton_PrivacyPreviewKeyDown"
                            Click="ConnectButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rede, voz e privacidade: secundário, sem dominar a Central -->
        <Expander Grid.Row="4"
                  Margin="0,10,0,0"
                  Header="Configurações avançadas da sala e da rede"
                  Foreground="#89A2B5"
                  FontWeight="SemiBold"
                  IsExpanded="False">
            <Border Margin="0,8,0,0"
                    Background="#081722"
                    BorderBrush="#1C3446"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="14">
                <ScrollViewer MaxHeight="310"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ServerLabelText"
                                   Grid.Row="0" Grid.Column="0"
                                   Margin="0,0,9,10"
                                   VerticalAlignment="Center"
                                   Foreground="#91A8BA"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ServerTextBox"
                                 Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                 Margin="0,0,0,10" />

                        <CheckBox x:Name="VoiceEnabledCheckBox"
                                  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  IsChecked="True"
                                  Margin="0,0,16,10" />
                        <CheckBox x:Name="PrivateRoomCheckBox"
                                  Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"
                                  Loaded="PrivateRoomCheckBox_Loaded"
                                  Checked="PrivateRoomCheckBox_Changed"
                                  Unchecked="PrivateRoomCheckBox_Changed" />

                        <TextBlock x:Name="ChatHotkeyLabelText"
                                   Grid.Row="2" Grid.Column="0"
                                   Margin="0,0,9,10"
                                   VerticalAlignment="Center"
                                   Foreground="#91A8BA"
                                   FontWeight="SemiBold" />
                        <ComboBox x:Name="ChatHotkeyComboBox"
                                  Grid.Row="2" Grid.Column="1"
                                  Width="155"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,16,10"
                                  SelectionChanged="HotkeyComboBox_SelectionChanged" />
                        <TextBlock x:Name="VoiceHotkeyLabelText"
                                   Grid.Row="2" Grid.Column="2"
                                   Margin="0,0,9,10"
                                   VerticalAlignment="Center"
                                   Foreground="#91A8BA"
                                   FontWeight="SemiBold"
                                   Text="PTT" />
                        <ComboBox x:Name="VoiceHotkeyComboBox"
                                  Grid.Row="2" Grid.Column="3"
                                  Width="155"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,10"
                                  SelectionChanged="HotkeyComboBox_SelectionChanged" />

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,10">
                            <CheckBox x:Name="UpnpEnabledCheckBox"
                                      FontWeight="SemiBold"
                                      Loaded="UpnpEnabledCheckBox_Loaded"
                                      Checked="UpnpEnabledCheckBox_Changed"
                                      Unchecked="UpnpEnabledCheckBox_Changed" />
                            <TextBlock x:Name="UpnpDescriptionText"
                                       Margin="22,4,0,0"
                                       Foreground="#7891A5"
                                       FontSize="10.5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <TextBlock x:Name="RoomPasswordLabelText"
                                       Foreground="#91A8BA"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5" />
                            <PasswordBox x:Name="RoomPasswordBox"
                                         MaxLength="128"
                                         Padding="9,6"
                                         PasswordChanged="RoomPasswordBox_PasswordChanged" />
                            <TextBlock x:Name="RoomPasswordHintText"
                                       Margin="0,4,0,0"
                                       Foreground="#7891A5"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,16,0">
                            <TextBlock Text="Windows Firewall" Foreground="#D9E5EC" FontWeight="SemiBold" />
                            <TextBlock x:Name="FirewallStatusText"
                                       Margin="0,3,0,6"
                                       Foreground="#7891A5"
                                       FontSize="10.5"
                                       TextWrapping="Wrap" />
                            <Button x:Name="FirewallButton"
                                    HorizontalAlignment="Left"
                                    MinWidth="170"
                                    Loaded="FirewallButton_Loaded"
                                    Click="FirewallButton_Click" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2">
                            <TextBlock x:Name="RoomPrivacyDescriptionText"
                                       Foreground="#7891A5"
                                       FontSize="10.5"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="RoomPrivacyStateText"
                                       Margin="0,5,0,0"
                                       Foreground="#68B9FF"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock x:Name="FooterText"
                                   Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                                   Margin="0,12,0,0"
                                   Foreground="#6F899D"
                                   FontSize="10.5"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Expander>
    </Grid>
</Window>