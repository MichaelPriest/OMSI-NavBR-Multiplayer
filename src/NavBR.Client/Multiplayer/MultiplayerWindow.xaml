<Window x:Class="NavBR.Client.Multiplayer.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMSI NavBR Multiplayer"
        Height="860" Width="1280"
        MinHeight="720" MinWidth="1040"
        Icon="../Assets/NavBR.ico"
        Background="#06101A"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="NavMultiplayerTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#97ABB9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#102638" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3D89C4" />
                                <Setter Property="Foreground" Value="#DAE6EE" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0D1A24" />
                                <Setter Property="Foreground" Value="#DAE6EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavMultiplayerCard" TargetType="Border">
            <Setter Property="Background" Value="#0A131A" />
            <Setter Property="BorderBrush" Value="#1C2A33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="NavMultiplayerSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#71C6FF" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid Margin="22" Background="#06101A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#DAE6EE" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,5,0,0"
                           Foreground="#97ABB9"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Background="#0C2A20"
                        BorderBrush="#1F5B45"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,7"
                        Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="9"
                                 Height="9"
                                 Fill="#888888"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Foreground="#7BE0A7"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#0B2132"
                        BorderBrush="#23465F"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,7">
                    <TextBlock Text="CENTRAL MULTIPLAYER • TCP 27730"
                               Foreground="#71C6FF"
                               FontSize="10.5"
                               FontWeight="Bold" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,16,0,14"
                Background="#0A1824"
                BorderBrush="#1D3445"
                BorderThickness="1"
                CornerRadius="13"
                Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SESSÃO ATUAL"
                               Foreground="#668198"
                               FontSize="9"
                               FontWeight="Bold" />
                    <TextBlock x:Name="StatusDetailText"
                               Margin="0,4,14,0"
                               Foreground="#DAE6EE"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="MAPA LOCAL"
                               Foreground="#668198"
                               FontSize="9"
                               FontWeight="Bold" />
                    <TextBlock x:Name="LocalMapValueText"
                               Margin="0,4,14,0"
                               Foreground="#C6D4DE"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LocalMapLabelText"
                               Visibility="Collapsed" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="#102639"
                        CornerRadius="10"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerCountText"
                               Foreground="#DAE6EE"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="MultiplayerTabs"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectedIndex="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource NavMultiplayerTabItem}" />
            </TabControl.Resources>

            <TabItem x:Name="OverviewTab" Header="Visão geral">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource NavMultiplayerCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mapa da sessão"
                                               Foreground="#DAE6EE"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Posições reais da sala; ônibus e personagens RP aparecem somente com dados compatíveis"
                                               Margin="0,3,0,0"
                                               Foreground="#7891A5"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#0A2B20"
                                        CornerRadius="9"
                                        Padding="9,5"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="AO VIVO"
                                               Foreground="#64D79A"
                                               FontSize="9"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="0,13,0,13"
                                    Background="#06131E"
                                    BorderBrush="#173247"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Canvas x:Name="LiveSessionCanvas"
                                            Grid.Row="0"
                                            Margin="12"
                                            ClipToBounds="True" />
                                    <Border Grid.Row="1"
                                            Background="#081C2A"
                                            CornerRadius="0,0,12,12"
                                            Padding="11,8">
                                        <TextBlock x:Name="LiveSessionHintText"
                                                   Text="Aguardando telemetria real compatível da sessão."
                                                   Foreground="#6F899D"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InviteAddressText"
                                           VerticalAlignment="Center"
                                           Foreground="#8198AA"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <Button x:Name="CopyInviteButton"
                                            Margin="8,0,0,0"
                                            IsEnabled="False"
                                            Loaded="CopyInviteButton_Loaded"
                                            Click="CopyInviteButton_Click" />
                                    <Button x:Name="PasteInviteButton"
                                            Margin="8,0,0,0"
                                            Loaded="PasteInviteButton_Loaded"
                                            Click="PasteInviteButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource NavMultiplayerCard}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top"
                                  Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Jogadores na sessão"
                                               Foreground="#DAE6EE"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Prévia rápida; detalhes completos na aba Jogadores"
                                               Foreground="#7891A5"
                                               FontSize="10"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#102639"
                                        CornerRadius="8"
                                        Padding="8,4"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="ONLINE"
                                               Foreground="#78BFFF"
                                               FontSize="9"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <ListBox x:Name="PlayersOverviewListBox"
                                     FontFamily="Segoe UI"
                                     FontSize="11"
                                     Background="#06131E"
                                     BorderThickness="0"
                                     Padding="5"
                                     IsHitTestVisible="False" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="RoomTab" Header="Sala">
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="ENTRAR OU CRIAR SALA"
                                           Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock Text="Configure sala e nome do motorista. Para host local, o PC que cria a sala usa TCP 27730."
                                           Margin="0,5,0,14"
                                           Foreground="#97ABB9"
                                           TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="RoomLabelText"
                                               Grid.Column="0"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="#91A8BA"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="RoomTextBox"
                                             Grid.Column="1"
                                             Margin="0,0,12,0"
                                             MaxLength="64" />
                                    <TextBlock x:Name="NicknameLabelText"
                                               Grid.Column="2"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="#91A8BA"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="NicknameTextBox"
                                             Grid.Column="3"
                                             Margin="0,0,12,0"
                                             MaxLength="32" />
                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal">
                                        <Button x:Name="CreateRoomButton"
                                                Style="{StaticResource NavPrimaryButton}"
                                                Margin="0,0,8,0"
                                                PreviewMouseLeftButtonDown="CreateRoomButton_PrivacyPreviewMouseLeftButtonDown"
                                                PreviewKeyDown="CreateRoomButton_PrivacyPreviewKeyDown"
                                                Click="CreateRoomButton_Click" />
                                        <Button x:Name="ConnectButton"
                                                PreviewMouseLeftButtonDown="ConnectButton_PrivacyPreviewMouseLeftButtonDown"
                                                PreviewKeyDown="ConnectButton_PrivacyPreviewKeyDown"
                                                Click="ConnectButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="ENDEREÇO DO SERVIDOR"
                                           Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock x:Name="ServerLabelText"
                                           Margin="0,8,0,5"
                                           Foreground="#91A8BA"
                                           FontWeight="SemiBold" />
                                <TextBox x:Name="ServerTextBox" />
                                <TextBlock Text="Para uma sala criada neste PC, o NavBR preenche o host local automaticamente. Servidor dedicado continua opcional."
                                           Margin="0,8,0,0"
                                           Foreground="#7891A5"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="PRIVACIDADE DA SALA"
                                           Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <CheckBox x:Name="PrivateRoomCheckBox"
                                          Margin="0,10,0,8"
                                          FontWeight="SemiBold"
                                          Loaded="PrivateRoomCheckBox_Loaded"
                                          Checked="PrivateRoomCheckBox_Changed"
                                          Unchecked="PrivateRoomCheckBox_Changed" />
                                <TextBlock x:Name="RoomPasswordLabelText"
                                           Foreground="#91A8BA"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5" />
                                <PasswordBox x:Name="RoomPasswordBox"
                                             MaxLength="128"
                                             Padding="9,6"
                                             PasswordChanged="RoomPasswordBox_PasswordChanged" />
                                <TextBlock x:Name="RoomPasswordHintText"
                                           Margin="0,4,0,0"
                                           Foreground="#7891A5"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RoomPrivacyDescriptionText"
                                           Margin="0,12,0,0"
                                           Foreground="#7891A5"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RoomPrivacyStateText"
                                           Margin="0,5,0,0"
                                           Foreground="#68B9FF"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="PlayersTab" Header="Jogadores">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.65*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource NavMultiplayerCard}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top"
                                  Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PlayersHeadingText"
                                               Foreground="#DAE6EE"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Mapa, velocidade e distância são mostrados somente quando há telemetria real."
                                               Margin="0,3,0,0"
                                               Foreground="#7891A5"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#102639"
                                        CornerRadius="8"
                                        Padding="9,5"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="SESSÃO"
                                               Foreground="#71C6FF"
                                               FontSize="9"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <ListBox x:Name="PlayersListBox"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     Background="#06131E"
                                     BorderThickness="0"
                                     Padding="6" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource NavMultiplayerCard}">
                        <StackPanel>
                            <TextBlock Text="ESTADOS DO JOGADOR"
                                       Style="{StaticResource NavMultiplayerSectionLabel}" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="#C6D4DE"
                                       FontSize="11.5"
                                       TextWrapping="Wrap">
                                <Run Text="• No ônibus: telemetria e, se ativado, veículo físico remoto." />
                                <LineBreak />
                                <Run Text="• Personagem/RP: estado a pé sincronizado em canal separado." />
                                <LineBreak />
                                <Run Text="• Sem telemetria compatível: o NavBR não inventa posição." />
                            </TextBlock>
                            <Border Margin="0,16,0,0"
                                    Padding="11"
                                    Background="#0D1A24"
                                    BorderBrush="#1C2A33"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock Text="Os nomes e marcadores usam somente presença/telemetria real da sala."
                                           Foreground="#97ABB9"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ChatVoiceTab" Header="Chat &amp; Voz">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.65*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource NavMultiplayerCard}">
                        <DockPanel>
                            <TextBlock x:Name="ChatHeadingText"
                                       DockPanel.Dock="Top"
                                       Foreground="#DAE6EE"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <Grid DockPanel.Dock="Bottom"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ChatTextBox"
                                         Grid.Column="0"
                                         MaxLength="280"
                                         KeyDown="ChatTextBox_KeyDown" />
                                <Button x:Name="SendChatButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource NavPrimaryButton}"
                                        Click="SendChatButton_Click" />
                            </Grid>
                            <ListBox x:Name="ChatListBox"
                                     Background="#06131E"
                                     BorderThickness="0" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource NavMultiplayerCard}">
                        <StackPanel>
                            <TextBlock Text="VOZ E ATALHOS"
                                       Style="{StaticResource NavMultiplayerSectionLabel}" />
                            <CheckBox x:Name="VoiceEnabledCheckBox"
                                      IsChecked="True"
                                      Margin="0,12,0,14"
                                      FontWeight="SemiBold" />

                            <TextBlock x:Name="ChatHotkeyLabelText"
                                       Foreground="#91A8BA"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="ChatHotkeyComboBox"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      Margin="0,6,0,14"
                                      SelectionChanged="HotkeyComboBox_SelectionChanged" />

                            <TextBlock x:Name="VoiceHotkeyLabelText"
                                       Foreground="#91A8BA"
                                       FontWeight="SemiBold"
                                       Text="PTT" />
                            <ComboBox x:Name="VoiceHotkeyComboBox"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      Margin="0,6,0,0"
                                      SelectionChanged="HotkeyComboBox_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="RoleplayTab" Header="Personagem / RP">
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel x:Name="RoleplayOptionsHost">
                                <TextBlock Text="PERSONAGEM DO MOTORISTA"
                                           Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock Text="A seleção é a mesma usada no modo normal. O multiplayer apenas sincroniza o estado quando uma sala estiver conectada."
                                           Margin="0,6,0,14"
                                           Foreground="#97ABB9"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,0,0,14"
                                        Padding="12"
                                        Background="#0D1A24"
                                        BorderBrush="#1C2A33"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Text="ESTADO ATUAL"
                                                   Style="{StaticResource NavMultiplayerSectionLabel}" />
                                        <TextBlock x:Name="RoleplayStateText"
                                                   Margin="0,6,0,10"
                                                   Foreground="#DAE6EE"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <Button x:Name="RoleplayActionButton"
                                                HorizontalAlignment="Left"
                                                MinWidth="190"
                                                Padding="12,7"
                                                Style="{StaticResource NavPrimaryButton}"
                                                Click="RoleplayActionButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="COMO FUNCIONA"
                                           Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="#C6D4DE"
                                           FontSize="11.5"
                                           TextWrapping="Wrap">
                                    <Run Text="1. Carregue mapa e ônibus no OMSI." />
                                    <LineBreak />
                                    <Run Text="2. Escolha um personagem real de Drivers." />
                                    <LineBreak />
                                    <Run Text="3. No modo normal, use Sair do ônibus / controlar personagem." />
                                    <LineBreak />
                                    <Run Text="4. Em uma sala, o estado RP é retransmitido separadamente da telemetria do ônibus." />
                                </TextBlock>
                                <Border Margin="0,16,0,0"
                                        Padding="11"
                                        Background="#0D1A24"
                                        BorderBrush="#1C2A33"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="W/S mover • A/D girar • Shift correr • Esc voltar ao ônibus"
                                               Foreground="#71C6FF"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AdvancedTab" Header="Avançado">
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="REDE"
                                           Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <CheckBox x:Name="UpnpEnabledCheckBox"
                                          Margin="0,12,0,0"
                                          FontWeight="SemiBold"
                                          Loaded="UpnpEnabledCheckBox_Loaded"
                                          Checked="UpnpEnabledCheckBox_Changed"
                                          Unchecked="UpnpEnabledCheckBox_Changed" />
                                <TextBlock x:Name="UpnpDescriptionText"
                                           Margin="22,4,0,14"
                                           Foreground="#7891A5"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="Windows Firewall"
                                           Foreground="#DAE6EE"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="FirewallStatusText"
                                           Margin="0,3,0,6"
                                           Foreground="#7891A5"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                                <Button x:Name="FirewallButton"
                                        HorizontalAlignment="Left"
                                        MinWidth="170"
                                        Loaded="FirewallButton_Loaded"
                                        Click="FirewallButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="EXPERIMENTAL E DIAGNÓSTICO"
                                           Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock Text="Recursos que escrevem no OMSI continuam opt-in. O NavBR não considera pronto nenhum recurso que o plugin não anunciar como capacidade real."
                                           Margin="0,6,0,14"
                                           Foreground="#97ABB9"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="ExperimentalOptionsHost" />
                                <TextBlock x:Name="FooterText"
                                           Margin="0,16,0,0"
                                           Foreground="#6F899D"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
