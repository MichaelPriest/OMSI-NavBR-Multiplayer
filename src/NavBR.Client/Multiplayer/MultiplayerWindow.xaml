                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MpText}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="FirewallStatusText"
                                               Margin="0,6,0,9"
                                               Foreground="#718A9B"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
