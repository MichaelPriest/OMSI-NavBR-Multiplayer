                                               Foreground="{StaticResource MpMuted}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#102639"
                                        CornerRadius="8"
                                        Padding="9,5"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="SESSÃO" Foreground="{StaticResource MpInteraction}" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <Border DockPanel.Dock="Top"
                                    Padding="11,7"
                                    Background="#07131D"
                                    BorderBrush="#172B38"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.45*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="0.65*" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="0.65*" />
                                        <ColumnDefinition Width="0.75*" />
                                        <ColumnDefinition Width="0.85*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="JOGADOR" Style="{StaticResource NavMetricLabel}" />
                                    <TextBlock Grid.Column="1" Text="ESTADO" Style="{StaticResource NavMetricLabel}" />
                                    <TextBlock Grid.Column="2" Text="ÔNIBUS" Style="{StaticResource NavMetricLabel}" />
                                    <TextBlock Grid.Column="3" Text="LINHA" Style="{StaticResource NavMetricLabel}" />
                                    <TextBlock Grid.Column="4" Text="VELOC." Style="{StaticResource NavMetricLabel}" />
                                    <TextBlock Grid.Column="5" Text="PING" Style="{StaticResource NavMetricLabel}" />
                                    <TextBlock Grid.Column="6" Text="VOZ" Style="{StaticResource NavMetricLabel}" />
                                    <TextBlock Grid.Column="7" Text="FÍSICO" Style="{StaticResource NavMetricLabel}" />
                                </Grid>
                            </Border>

                            <ListBox x:Name="PlayersListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="11,9"
                                                Background="#081722"
                                                BorderBrush="#172B38"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.45*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1.35*" />
                                                    <ColumnDefinition Width="0.65*" />
                                                    <ColumnDefinition Width="0.75*" />
                                                    <ColumnDefinition Width="0.65*" />
                                                    <ColumnDefinition Width="0.75*" />
                                                    <ColumnDefinition Width="0.85*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource MpText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding YouLabel}" Margin="0,2,0,0" Foreground="{StaticResource MpInteraction}" FontSize="8.5" FontWeight="Bold" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Mode}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Bus}" Foreground="#B9CAD5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Line}" Foreground="#B9CAD5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding Speed}" Foreground="#B9CAD5" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding Ping}" Foreground="#B9CAD5" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding Voice}" Foreground="#B9CAD5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="0" Grid.Column="7" Text="{Binding Physical}" Foreground="#B9CAD5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8"
                                                           Text="{Binding Secondary}"
                                                           Margin="0,5,0,0"
                                                           Foreground="#6F8798"
                                                           FontSize="9.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource NavMultiplayerCard}">
                        <StackPanel>
                            <TextBlock Text="LEITURA RÁPIDA" Style="{StaticResource NavMultiplayerSectionLabel}" />
                            <TextBlock Text="No ônibus"
                                       Margin="0,11,0,0"
                                       Foreground="{StaticResource MpText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Telemetria do veículo ativa."
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource MpMuted}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="A pé / Correndo / Parado"
                                       Margin="0,13,0,0"
                                       Foreground="{StaticResource MpText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Estado RP recebido pelo canal de personagem."
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource MpMuted}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Ônibus físico"
                                       Margin="0,13,0,0"
                                       Foreground="{StaticResource MpText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Mostra se o veículo remoto está realmente criado pelo plugin local."
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource MpMuted}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,15,0,0"
                                    Padding="11"
                                    Background="#0D1A24"
                                    BorderBrush="#1C2A33"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock Text="Campos sem telemetria/capacidade real permanecem como “—”."
                                           Foreground="#8FA5B4"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ChatVoiceTab" Header="Chat &amp; Voz">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.5*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource NavMultiplayerHeroCard}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock x:Name="ChatHeadingText"
                                           Foreground="{StaticResource MpText}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Mensagens da sala atual"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource MpMuted}"
                                           FontSize="10.5" />
                            </StackPanel>

                            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ChatTextBox"
                                         Grid.Column="0"
                                         MinHeight="40"
                                         MaxLength="280"
                                         Padding="12,9"
                                         KeyDown="ChatTextBox_KeyDown" />
                                <Button x:Name="SendChatButton"
                                        Grid.Column="1"
                                        Margin="9,0,0,0"
                                        MinWidth="98"
                                        Style="{StaticResource NavPrimaryButton}"
                                        Click="SendChatButton_Click" />
                            </Grid>

                            <ListBox x:Name="ChatListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="11,9"
                                                Background="#081722"
                                                BorderBrush="#172B38"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{Binding AccentBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="10.5" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Time}"
                                                               Foreground="#647E90"
                                                               FontSize="9.5" />
                                                </Grid>
                                                <TextBlock Text="{Binding Text}"
                                                           Margin="0,5,0,0"
                                                           Foreground="#C8D7E0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="VOZ / PTT" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock x:Name="VoiceSessionStatusText"
                                           Text="Voz disponível na sessão"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource MpText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <CheckBox x:Name="VoiceEnabledCheckBox"
                                          IsChecked="True"
                                          Margin="0,12,0,0"
                                          FontWeight="SemiBold"
                                          Checked="VoiceEnabledCheckBox_Changed"
                                          Unchecked="VoiceEnabledCheckBox_Changed" />
                                <Border Margin="0,13,0,0"
                                        Padding="10"
                                        Background="#102333"
                                        CornerRadius="8">
                                    <TextBlock Text="Segure o atalho PTT para transmitir. O estado “Falando” só aparece quando quadros de voz reais são recebidos."
                                               Foreground="#8FA5B4"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource NavMultiplayerCard}">
                            <StackPanel>
                                <TextBlock Text="ATALHOS" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                <TextBlock x:Name="ChatHotkeyLabelText"
                                           Margin="0,11,0,0"
                                           Style="{StaticResource NavInputLabel}" />
                                <ComboBox x:Name="ChatHotkeyComboBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="HotkeyComboBox_SelectionChanged" />

                                <TextBlock x:Name="VoiceHotkeyLabelText"
                                           Text="PTT"
                                           Margin="0,13,0,0"
                                           Style="{StaticResource NavInputLabel}" />
                                <ComboBox x:Name="VoiceHotkeyComboBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="HotkeyComboBox_SelectionChanged" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="RoleplayTab" Header="Personagem / RP">
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="0.75*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource NavMultiplayerHeroCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="PERSONAGEM / RP" Style="{StaticResource NavMultiplayerSectionLabel}" />
                                    <TextBlock Text="Assuma o motorista humano real do ônibus"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MpText}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="A seleção vem da lista Drivers do OMSI e é compartilhada com o HUD e a janela normal de Personagem/RP."
