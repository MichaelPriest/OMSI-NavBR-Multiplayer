                        <ColumnDefinition Width="1.65*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.55*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource NavMultiplayerHeroCard}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PlayersHeadingText"
                                               Foreground="{StaticResource MpText}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
