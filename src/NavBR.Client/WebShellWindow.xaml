<Window x:Class="NavBR.Client.WebShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OMSI NavBR Multiplayer — Nova interface"
        Width="1360"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        Background="#06101A"
        Icon="Assets/NavBR.ico"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />
        <Border x:Name="ErrorPanel"
                Visibility="Collapsed"
                Margin="28"
                Padding="24"
                Background="#0A131A"
                BorderBrush="#1C2A33"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
                <TextBlock Text="A nova interface web não pôde ser carregada."
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock x:Name="ErrorText"
                           Margin="0,12,0,0"
                           Foreground="#97ABB9"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
