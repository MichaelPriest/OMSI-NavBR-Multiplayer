<Window x:Class="NavBR.Client.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Feedback — OMSI NavBR Multiplayer"
        Height="620" Width="900"
        MinHeight="560" MinWidth="780"
        Icon="Assets/NavBR.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="58" Height="58"
                        Background="#24170D"
                        BorderBrush="{StaticResource NavBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="7"
                        Margin="0,0,16,0">
                    <Image Source="Assets/NavBR.ico" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NavTextBrush}" />
                    <TextBlock x:Name="LeadText"
                               Margin="0,6,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Style="{StaticResource NavMutedText}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource NavCard}">
                    <StackPanel>
                        <Border Width="42" Height="42" HorizontalAlignment="Left"
                                Background="#3A160C" CornerRadius="11">
                            <TextBlock Text="!" FontWeight="Bold" FontSize="22"
                                       Foreground="#FFFF8A2A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="BugTitleText" Margin="0,14,0,0"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="BugBodyText" Margin="0,8,0,16"
                                   TextWrapping="Wrap" Style="{StaticResource NavMutedText}" />
                        <Button x:Name="BugButton"
                                Style="{StaticResource NavPrimaryButton}"
                                HorizontalAlignment="Left"
                                Click="BugButton_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource NavCard}">
                    <StackPanel>
                        <Border Width="42" Height="42" HorizontalAlignment="Left"
                                Background="#282828" CornerRadius="11">
                            <TextBlock Text="+" FontWeight="Bold" FontSize="22"
                                       Foreground="#FFD0D0D0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="SuggestionTitleText" Margin="0,14,0,0"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="SuggestionBodyText" Margin="0,8,0,16"
                                   TextWrapping="Wrap" Style="{StaticResource NavMutedText}" />
                        <Button x:Name="SuggestionButton"
                                HorizontalAlignment="Left"
                                Click="SuggestionButton_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource NavCard}">
                    <StackPanel>
                        <Border Width="42" Height="42" HorizontalAlignment="Left"
                                Background="#282828" CornerRadius="11">
                            <TextBlock Text="★" FontWeight="Bold" FontSize="18"
                                       Foreground="#FFFFA14D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="GeneralTitleText" Margin="0,14,0,0"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="GeneralBodyText" Margin="0,8,0,16"
                                   TextWrapping="Wrap" Style="{StaticResource NavMutedText}" />
                        <Button x:Name="GeneralButton"
                                HorizontalAlignment="Left"
                                Click="GeneralButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,18,0,0"
                    Background="#111111"
                    BorderBrush="{StaticResource NavBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PrivacyHeadingText"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="PrivacyText"
                                   Margin="0,5,16,0"
                                   Style="{StaticResource NavMutedText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ViewFeedbackButton"
                            Grid.Column="1"
                            MinWidth="150"
                            VerticalAlignment="Center"
                            Click="ViewFeedbackButton_Click" />
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       Margin="2,14,2,0"
                       MinHeight="20"
                       Style="{StaticResource NavMutedText}"
                       TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</Window>
