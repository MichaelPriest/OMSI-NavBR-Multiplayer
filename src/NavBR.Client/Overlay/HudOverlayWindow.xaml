<Window x:Class="NavBR.Client.Overlay.HudOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Loaded="HudOverlayWindow_LifecycleLoaded"
        Closed="HudOverlayWindow_LifecycleClosed">
    <Grid x:Name="OverlayRoot">
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="24,24,24,22"
                    Width="520">

            <Border x:Name="ChatPanel"
                    Background="#B10B0F14"
                    BorderBrush="#553FFFFFF"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10,8"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="ChatLinesText"
                           Foreground="White"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Width="300" Height="190" HorizontalAlignment="Left">
                <Border Background="#D20B0F14"
                        BorderBrush="#CCFFFFFF"
                        BorderThickness="2"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Canvas x:Name="MiniMapCanvas"
                            Width="296"
                            Height="186"
                            ClipToBounds="True"
                            Background="#FF121820">
                        <Image x:Name="MiniMapImage"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Canvas>
                </Border>

                <Grid x:Name="LocalMarker"
                      Width="30" Height="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="LocalMarkerRotation" />
                    </Grid.RenderTransform>
                    <Ellipse Fill="#E6000000" Stroke="White" StrokeThickness="2" />
                    <Polygon Points="15,3 22,23 15,18 8,23"
                             Fill="#FFFF8C00"
                             Stroke="White"
                             StrokeThickness="1" />
                </Grid>

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8"
                        Background="#B0000000"
                        CornerRadius="4"
                        Padding="6,3">
                    <TextBlock x:Name="MiniMapStatusText"
                               Foreground="White"
                               FontSize="11"
                               Text="NavBR" />
                </Border>
            </Grid>

            <Border Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Background="#B10B0F14"
                    CornerRadius="6"
                    Padding="9,5">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ConnectionDot"
                             Width="9" Height="9"
                             Fill="#FF808080"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="HudStatusText"
                               Foreground="White"
                               FontSize="12"
                               Text="NavBR offline" />
                    <TextBlock Text="  •  "
                               Foreground="#BFFFFFFF"
                               FontSize="12" />
                    <TextBlock Text="👥"
                               FontFamily="Segoe UI Emoji"
                               Foreground="White"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="PlayerCountText"
                               Text="0"
                               Margin="4,0,0,0"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="HudShortcutsText"
                               Text="  •  F9: chat  •  F10: PTT"
                               Foreground="#BFFFFFFF"
                               FontSize="12" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border x:Name="VoicePanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="338,0,0,45"
                Background="#C20B0F14"
                CornerRadius="7"
                Padding="10,7"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="VoiceDot"
                         Width="10" Height="10"
                         Fill="#FF56E36B"
                         Margin="0,0,7,0"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="VoiceStatusText"
                           Foreground="White"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border x:Name="ChatInputPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Width="520"
                Margin="24,0,0,225"
                Background="#F00B0F14"
                BorderBrush="#FFFF8C00"
                BorderThickness="1"
                CornerRadius="7"
                Padding="8"
                Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="ChatInputLabelText"
                           Text="CHAT"
                           Foreground="#FFFF8C00"
                           FontWeight="Bold"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBox x:Name="ChatInputBox"
                         Background="Transparent"
                         Foreground="White"
                         BorderThickness="0"
                         FontSize="15"
                         MaxLength="280"
                         KeyDown="ChatInputBox_KeyDown" />
            </DockPanel>
        </Border>
    </Grid>
</Window>