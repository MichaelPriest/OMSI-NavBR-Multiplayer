<UserControl
    x:Class="NavBR.Client.WinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="Configurações"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"/>
            <TextBlock Text="Idioma, instalações OMSI e preferências do aplicativo."
                       Foreground="{StaticResource NavBRMutedBrush}"/>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Interface" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <ComboBox x:Name="LanguageComboBox"
                              Header="Idioma"
                              Width="320"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    <CheckBox x:Name="AdvancedModeCheckBox" Content="Modo avançado"/>
                    <CheckBox x:Name="DrivingTipsCheckBox" Content="Mostrar dicas de condução"/>
                    <Button Content="Salvar preferências"
                            HorizontalAlignment="Left"
                            Click="SavePreferences_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Instalações do OMSI 2" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InstallationsNoticeText" Text="—" Foreground="{StaticResource NavBRMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Detectar instalações" Click="Discover_Click"/>
                            <Button Content="Selecionar pasta" Click="SelectFolder_Click"/>
                            <Button Content="Selecionar Omsi.exe" Click="SelectExe_Click"/>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="InstallationsList"
                              Height="280"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource NavBRAccentBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding InstallDirectory}" Foreground="{StaticResource NavBRMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Preferred}" Foreground="White" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Iniciar OMSI selecionado" Click="LaunchProfile_Click"/>
                        <Button Content="Definir como principal" Click="PreferredProfile_Click"/>
                        <Button Content="Abrir pasta" Click="OpenFolder_Click"/>
                        <Button Content="Remover perfil" Click="RemoveProfile_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
