<Window
    x:Class="NavBR.Client.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NavBR.Client.WinUI"
    Title="OMSI NavBR Multiplayer">

    <Grid x:Name="RootGrid"
          Background="{StaticResource NavBRBackgroundBrush}"
          Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="#0A1621"
              Padding="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Border Width="30"
                        Height="30"
                        CornerRadius="8"
                        Background="{StaticResource NavBRAccentBrush}">
                    <TextBlock Text="N"
                               Foreground="#06101A"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="-2">
                    <TextBlock Text="OMSI NAVBR MULTIPLAYER"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="NATIVE OPERATIONS PLATFORM"
                               Foreground="{StaticResource NavBRAccentBrush}"
                               FontSize="9"
                               CharacterSpacing="100"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <Border Background="#102535"
                        CornerRadius="12"
                        Padding="10,4">
                    <TextBlock x:Name="RuntimeBadgeText"
                               Text="RUNTIME..."
                               Foreground="{StaticResource NavBRMutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="WinUI 3 · x64"
                           Foreground="{StaticResource NavBRMutedBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Navigation"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneOpen="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="224"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Início" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Multiplayer" Tag="multiplayer">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="CCO" Tag="cco">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Empresa" Tag="company">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Navegação" Tag="navigation">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE707;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Personagem RP" Tag="roleplay">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="HUD e Telematrix" Tag="hud">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hardware" Tag="hardware">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Desempenho" Tag="performance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Diagnóstico" Tag="diagnostics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Configurações" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <ScrollViewer x:Name="HomePage"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24"
                                Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Central operacional"
                                           Foreground="White"
                                           FontSize="32"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="HomeSubtitle"
                                           Text="Conectando ao Runtime Host..."
                                           Foreground="{StaticResource NavBRMutedBrush}"
                                           FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Content="Atualizar"
                                        Click="RefreshButton_Click"/>
                                <Button Content="Abrir OMSI"
                                        Click="LaunchOmsiButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="OMSI" Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock x:Name="OmsiStatusText" Text="—" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OmsiDetailText" Text="Aguardando" Foreground="{StaticResource NavBRMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="MULTIPLAYER" Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock x:Name="MultiplayerStatusText" Text="—" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MultiplayerDetailText" Text="Aguardando" Foreground="{StaticResource NavBRMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="EMPRESA / CRACHÁ" Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock x:Name="CompanyStatusText" Text="—" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CompanyDetailText" Text="Aguardando" Foreground="{StaticResource NavBRMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="PERFORMANCE BRIDGE" Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock x:Name="PerformanceStatusText" Text="—" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PerformanceDetailText" Text="Aguardando" Foreground="{StaticResource NavBRMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Operação atual" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OperationText"
                                               Text="Nenhuma telemetria recebida."
                                               Foreground="{StaticResource NavBRMutedBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Acesso rápido" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <Button Content="Multiplayer" Tag="multiplayer" Click="QuickNavButton_Click"/>
                                    <Button Content="CCO" Tag="cco" Click="QuickNavButton_Click"/>
                                    <Button Content="Rede da Empresa" Tag="company" Click="QuickNavButton_Click"/>
                                    <Button Content="Desempenho" Tag="performance" Click="QuickNavButton_Click"/>
                                    <Button Content="Interface anterior (temporário)" Click="LegacyShellButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PerformancePage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" Spacing="16">
                        <TextBlock Text="Performance Bridge"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Controle adaptativo do trabalho do NavBR dentro do thread do OMSI."
                                   Foreground="{StaticResource NavBRMutedBrush}"/>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                <StackPanel><TextBlock Text="PRESSÃO" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="PressureText" Text="—" Foreground="White" FontSize="26"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                <StackPanel><TextBlock Text="TRABALHO DO PLUGIN" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="PluginWorkText" Text="—" Foreground="White" FontSize="26"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                                <StackPanel><TextBlock Text="FRAME INTERVAL" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="FrameIntervalText" Text="—" Foreground="White" FontSize="26"/></StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                                <StackPanel><TextBlock Text="COMANDOS / SLICE" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="CommandBudgetText" Text="—" Foreground="White" FontSize="26"/></StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ÚLTIMO INTERVALO"
                                               Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock x:Name="LastFrameIntervalText"
                                               Text="—"
                                               Foreground="White"
                                               FontSize="22"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PIOR INTERVALO"
                                               Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock x:Name="PeakFrameIntervalText"
                                               Text="—"
                                               Foreground="White"
                                               FontSize="22"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="STUTTERS ≥ 100 MS"
                                               Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock x:Name="FrameStallCountText"
                                               Text="—"
                                               Foreground="White"
                                               FontSize="22"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA PRIVADA DO OMSI"
                                               Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock x:Name="OmsiPrivateMemoryText"
                                               Text="—"
                                               Foreground="White"
                                               FontSize="26"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PRESSÃO DE MEMÓRIA"
                                               Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock x:Name="OmsiMemoryLevelText"
                                               Text="—"
                                               Foreground="White"
                                               FontSize="26"/>
                                </StackPanel>
                                <TextBlock x:Name="OmsiMemoryAdviceText"
                                           Grid.Column="2"
                                           Text="O monitor é apenas observacional e não força limpeza de memória do OMSI."
                                           Foreground="{StaticResource NavBRMutedBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="320"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Perfil de desempenho"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PerformanceProfileDetailText"
                                                   Text="Automático"
                                                   Foreground="{StaticResource NavBRMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="RuntimeCadenceText"
                                                   Text="Host x86: aguardando dados"
                                                   Foreground="#6F8798"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox x:Name="PerformanceProfileComboBox"
                                              Grid.Column="1"
                                              Header="Modo"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="PerformanceProfileComboBox_SelectionChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Estado adaptativo" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PerformanceExplanationText"
                                           Text="Aguardando dados do plugin..."
                                           Foreground="{StaticResource NavBRMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <local:MultiplayerPage x:Name="NativeMultiplayerPage"
                                       Visibility="Collapsed"/>

                <local:NavigationPage x:Name="NativeNavigationPage"
                                      Visibility="Collapsed"/>

                <local:RoleplayPage x:Name="NativeRoleplayPage"
                                    Visibility="Collapsed"/>

                <local:HudPage x:Name="NativeHudPage"
                               Visibility="Collapsed"/>

                <local:HardwarePage x:Name="NativeHardwarePage"
                                    Visibility="Collapsed"/>

                <local:DiagnosticsPage x:Name="NativeDiagnosticsPage"
                                       Visibility="Collapsed"/>

                <local:SettingsPage x:Name="NativeSettingsPage"
                                    Visibility="Collapsed"/>

                <local:OperationsPage x:Name="NativeOperationsPage"
                                      Visibility="Collapsed"/>

                <local:CompanyPage x:Name="NativeCompanyPage"
                                   Visibility="Collapsed"/>

                <ScrollViewer x:Name="ModulePage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" Spacing="16">
                        <TextBlock x:Name="ModuleTitleText"
                                   Text="Módulo"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="ModuleSubtitleText"
                                   Text="Migração WinUI em andamento."
                                   Foreground="{StaticResource NavBRMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Runtime compartilhado" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ModuleStateText"
                                           Text="O módulo já utiliza o mesmo backend do NavBR. A interface nativa está sendo migrada progressivamente."
                                           Foreground="{StaticResource NavBRMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <Grid Grid.Row="2"
              Background="#09141E"
              Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText"
                       Text="Inicializando..."
                       Foreground="{StaticResource NavBRMutedBrush}"
                       FontSize="10"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="NavBR WinUI Platform Preview"
                       Foreground="#607788"
                       FontSize="10"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
