<UserControl
    x:Class="NavBR.Client.WinUI.MultiplayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Multiplayer"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Salas, jogadores e ônibus físicos."
                               Foreground="{StaticResource NavBRMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ConnectButton" Content="Conectar" Click="Connect_Click"/>
                    <Button x:Name="DisconnectButton" Content="Desconectar" Click="Disconnect_Click"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource MetricCardStyle}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerTextBox" Header="Servidor"/>
                    <TextBox x:Name="RoomTextBox" Grid.Column="1" Header="Sala"/>
                    <TextBox x:Name="DisplayNameTextBox" Grid.Column="2" Header="Nome"/>
                    <PasswordBox x:Name="PasswordTextBox" Grid.Column="3" Header="Senha da sala"/>
                </Grid>
            </Border>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock Text="ESTADO" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="ConnectionText" Text="OFFLINE" Foreground="White" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock Text="JOGADORES" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="PlayerCountText" Text="0" Foreground="White" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock Text="REDE" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="NetworkText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ÔNIBUS FÍSICOS" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <ToggleSwitch x:Name="PhysicalVehiclesToggle"
                                      OffContent="Desativados"
                                      OnContent="Ativados"
                                      Toggled="PhysicalVehicles_Toggled"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Jogadores na sessão" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <ListView x:Name="PlayersList" Height="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Badge}" Foreground="{StaticResource NavBRAccentBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Service}" Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Vehicle}" Foreground="{StaticResource NavBRMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PhysicalState}" Foreground="{StaticResource NavBRMutedBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Latency}" Foreground="White" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
