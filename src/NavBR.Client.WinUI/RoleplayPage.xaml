<UserControl
    x:Class="NavBR.Client.WinUI.RoleplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Personagem RP"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Personagem, caminhada e interação com o ônibus."
                               Foreground="{StaticResource NavBRMutedBrush}"/>
                </StackPanel>
                <ToggleSwitch x:Name="EnabledToggle"
                              Grid.Column="1"
                              Header="Modo RP"
                              OffContent="Desativado"
                              OnContent="Ativado"
                              Toggled="EnabledToggle_Toggled"/>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock Text="RUNTIME" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="RuntimeText" Text="—" Foreground="White" FontSize="20"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock Text="ESTADO" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="ActiveText" Text="PARADO" Foreground="White" FontSize="20"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock Text="DISTÂNCIA DO ÔNIBUS" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="BusDistanceText" Text="—" Foreground="White" FontSize="20"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock Text="ATIVIDADE" Foreground="{StaticResource NavBRMutedBrush}"/><TextBlock x:Name="ActivityText" Text="—" Foreground="White" FontSize="20"/></StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Controle do personagem" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CharacterComboBox"
                              Header="Personagem"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="CharacterComboBox_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StartButton" Content="Iniciar caminhada" Click="Start_Click"/>
                        <Button x:Name="EnterBusButton" Content="Entrar no ônibus" Click="EnterBus_Click"/>
                        <Button x:Name="StopButton" Content="Encerrar / retornar" Click="Stop_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PositionText"
                               Text="Posição: —"
                               Foreground="{StaticResource NavBRMutedBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Interações com o ônibus" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <ListView x:Name="InteractionsList"
                              Height="180"
                              SelectionMode="Single"/>
                    <Button x:Name="TriggerInteractionButton"
                            Content="Executar interação selecionada"
                            Click="TriggerInteraction_Click"/>
                </StackPanel>
            </Border>

            <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
