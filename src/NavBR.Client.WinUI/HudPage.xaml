<UserControl
    x:Class="NavBR.Client.WinUI.HudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="HUD e Telematrix"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"/>
            <TextBlock Text="Configure o HUD operacional sem sair do WinUI."
                       Foreground="{StaticResource NavBRMutedBrush}"/>

            <Border Style="{StaticResource MetricCardStyle}">
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ToggleSwitch x:Name="EnabledToggle" Header="HUD" OffContent="Desativado" OnContent="Ativado"/>
                    <ComboBox x:Name="PresetComboBox" Grid.Column="1" Header="Preset" DisplayMemberPath="DisplayName"/>
                    <ComboBox x:Name="ThemeComboBox" Grid.Column="2" Header="Tema" DisplayMemberPath="DisplayName"/>
                    <ComboBox x:Name="AnchorComboBox" Grid.Row="1" Header="Posição" DisplayMemberPath="DisplayName"/>
                    <NumberBox x:Name="ScaleNumberBox" Grid.Row="1" Grid.Column="1" Header="Escala" Minimum="0.6" Maximum="1.8" SmallChange="0.05"/>
                    <NumberBox x:Name="OpacityNumberBox" Grid.Row="1" Grid.Column="2" Header="Opacidade" Minimum="0.35" Maximum="1" SmallChange="0.05"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Módulos do HUD" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="FuelCheckBox" Content="Combustível"/>
                        <CheckBox x:Name="PedalsCheckBox" Grid.Column="1" Content="Pedais"/>
                        <CheckBox x:Name="StatusCheckBox" Grid.Column="2" Content="Status"/>
                        <CheckBox x:Name="MinimapCheckBox" Grid.Row="1" Content="Minimapa"/>
                        <CheckBox x:Name="MultiplayerCheckBox" Grid.Row="1" Grid.Column="1" Content="Multiplayer"/>
                        <CheckBox x:Name="AlertsCheckBox" Grid.Row="1" Grid.Column="2" Content="Alertas"/>
                        <CheckBox x:Name="SideIndicatorsCheckBox" Grid.Row="2" Content="Indicadores laterais"/>
                        <CheckBox x:Name="AutoScaleCheckBox" Grid.Row="2" Grid.Column="1" Content="Escala automática"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Pré-visualizar" Click="Preview_Click"/>
                <Button Content="Salvar" Click="Save_Click"/>
                <Button Content="Limpar prévia" Click="ClearPreview_Click"/>
                <Button Content="Restaurar padrão" Click="Reset_Click"/>
                <Button Content="Alternar layout" Click="ToggleLayout_Click"/>
            </StackPanel>

            <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
