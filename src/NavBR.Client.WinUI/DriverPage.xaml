<UserControl
    x:Class="NavBR.Client.WinUI.DriverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="Motorista"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"/>
            <TextBlock Text="Perfil local, estatísticas acumuladas e histórico de viagens registrados pelo Runtime Host."
                       Foreground="{StaticResource NavBRMutedBrush}"
                       TextWrapping="Wrap"/>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TEMPO AO VOLANTE" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="DrivingTimeText" Text="0 h" Foreground="White" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DISTÂNCIA" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="DistanceText" Text="0 km" Foreground="White" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="VIAGENS" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="TripsText" Text="0" Foreground="White" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MÉDIA EM MOVIMENTO" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="AverageSpeedText" Text="0 km/h" Foreground="White" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="VELOCIDADE MÁX." Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="HighestSpeedText" Text="0 km/h" Foreground="White" FontSize="20"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Perfil do motorista"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="DisplayNameTextBox"
                                 Header="Nome"
                                 PlaceholderText="Nome do motorista"/>
                        <TextBox x:Name="CompanyNameTextBox"
                                 Header="Empresa"
                                 PlaceholderText="Empresa / operador"/>
                        <Button Content="Salvar perfil"
                                HorizontalAlignment="Left"
                                Click="SaveProfile_Click"/>
                        <TextBlock x:Name="LastOperationText"
                                   Text="Última operação: —"
                                   Foreground="{StaticResource NavBRMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Portabilidade"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Exporte ou importe o perfil junto com o histórico de viagens."
                                   Foreground="{StaticResource NavBRMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Exportar"
                                    Click="ExportProfile_Click"/>
                            <Button Content="Selecionar importação"
                                    Click="SelectImport_Click"/>
                            <Button x:Name="ApplyImportButton"
                                    Content="Aplicar importação"
                                    Click="ApplyImport_Click"/>
                            <Button x:Name="CancelImportButton"
                                    Content="Cancelar"
                                    Click="CancelImport_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="PendingImportText"
                                   Text="Nenhuma importação pendente."
                                   Foreground="{StaticResource NavBRMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Histórico de viagens"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="HistorySummaryText"
                                       Text="Nenhuma viagem registrada."
                                       Foreground="{StaticResource NavBRMutedBrush}"/>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="TripHistoryList"
                              MinHeight="260">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DateText}"
                                               Foreground="{StaticResource NavBRMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Service}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Vehicle}"
                                                   Foreground="{StaticResource NavBRMutedBrush}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DurationDistance}"
                                               Foreground="{StaticResource NavBRMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding HighestSpeed}"
                                               Foreground="{StaticResource NavBRMutedBrush}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <InfoBar x:Name="NoticeBar"
                     IsOpen="False"
                     IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
