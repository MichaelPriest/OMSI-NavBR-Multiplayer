<UserControl
    x:Class="NavBR.Client.WinUI.CompanyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Rede da Empresa"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Empresa Online, crachá, equipe e Company Node."
                               Foreground="{StaticResource NavBRMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Atualizar" Click="Refresh_Click"/>
                    <Button x:Name="StartNodeButton" Content="Iniciar Node" Click="StartNode_Click"/>
                    <Button x:Name="StopNodeButton" Content="Parar Node" Click="StopNode_Click"/>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="EMPRESA" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="CompanyNameText" Text="—" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CompanyMetaText" Text="Nenhuma empresa carregada" Foreground="{StaticResource NavBRMutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="CRACHÁ" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="BadgeNumberText" Text="—" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BadgeRoleText" Text="Sem credencial" Foreground="{StaticResource NavBRMutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="COMPANY NODE" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="NodeStateText" Text="OFFLINE" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NodeAddressText" Text="—" Foreground="{StaticResource NavBRMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Equipe" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MemberCountText" Text="0 funcionários" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <ListView x:Name="MembersList"
                                  Height="310"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding EmployeeNumber}" Foreground="{StaticResource NavBRAccentBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="White"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Role}" Foreground="{StaticResource NavBRMutedBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Permissions}" Foreground="#708696" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="RoleComboBox" Width="180"/>
                            <Button x:Name="ChangeRoleButton" Content="Alterar cargo" Click="ChangeRole_Click"/>
                            <Button x:Name="RemoveMemberButton" Content="Remover funcionário" Click="RemoveMember_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="12">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Criar convite" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <ComboBox x:Name="InviteRoleComboBox"/>
                            <Button x:Name="CreateInviteButton" Content="Gerar convite" Click="CreateInvite_Click"/>
                            <TextBox x:Name="InvitePayloadTextBox"
                                     Header="Convite"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="74"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Entrar em uma empresa" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBox x:Name="JoinNodeUrlTextBox" Header="Endereço do Company Node"/>
                            <TextBox x:Name="JoinInviteCodeTextBox" Header="Código do convite"/>
                            <Button Content="Entrar" Click="JoinCompany_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="NoticeBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
