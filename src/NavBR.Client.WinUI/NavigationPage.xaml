<UserControl
    x:Class="NavBR.Client.WinUI.NavigationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="Navegação"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Aguardando uma rota ativa do OMSI."
                       Foreground="{StaticResource NavBRMutedBrush}"/>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="PRÓXIMA PARADA" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="NextStopText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MANOBRA" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="ManeuverText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DISTÂNCIA" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="DistanceText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ETA" Foreground="{StaticResource NavBRMutedBrush}"/>
                        <TextBlock x:Name="EtaText" Text="—" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ServiceText" Text="Linha — / Rota —" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DestinationText" Text="Destino —" Foreground="{StaticResource NavBRMutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="RouteStateText"
                                   Grid.Column="1"
                                   Text="SEM ROTA"
                                   Foreground="{StaticResource NavBRAccentBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="RouteProgressBar" Minimum="0" Maximum="100" Height="8"/>
                    <TextBlock x:Name="RouteProgressText" Text="0%" Foreground="{StaticResource NavBRMutedBrush}"/>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Próximas paradas" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <ListView x:Name="UpcomingStopsList" Height="240"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Diagnóstico da rota" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RouteDiagnosticText"
                                   Text="Aguardando dados."
                                   Foreground="{StaticResource NavBRMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
