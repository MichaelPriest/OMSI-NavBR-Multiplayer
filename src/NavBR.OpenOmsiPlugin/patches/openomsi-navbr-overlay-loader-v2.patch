+
+    /// Latest optional renderer frame exposed by enhanced openOMSI plugins.
+    ///
+    /// This is intentionally not part of the legacy OMSI ABI. A plugin without the
+    /// symbol simply returns None. The payload is UTF-8 JSON; parsing belongs to the
+    /// application crate, not to omsi-plugin.
+    pub fn overlay_frame_v2(&self) -> Option<Vec<u8>> {
+        let read = self.overlay_frame_v2?;
+        let required = unsafe { read(std::ptr::null_mut(), 0) };
+        if !(2..=262_144).contains(&required) {
+            return None;
+        }
+
+        let mut bytes = vec![0u8; required as usize];
+        let written = unsafe { read(bytes.as_mut_ptr(), required) };
+        if written <= 0 {
+            return None;
+        }
+        if written >= required {
+            // The producer published a newer, larger frame between probe and read.
+            // Resize to the newly requested capacity and retry once.
+            if written > 262_144 {
+                return None;
+            }
+            bytes.resize(written as usize, 0);
+            let second = unsafe { read(bytes.as_mut_ptr(), written) };
+            if second <= 0 || second >= written {
+                return None;
+            }
+            bytes.truncate(second as usize);
+            return Some(bytes);
+        }
+
+        bytes.truncate(written as usize);
+        Some(bytes)
+    }
