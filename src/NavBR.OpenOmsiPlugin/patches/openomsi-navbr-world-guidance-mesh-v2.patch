+fn arrow_mesh() -> MeshData {
+    // Unit arrow authored along +Y. Width/length arrive per primitive.
+    // Six outline points, triangulated around a short shaft and triangular head.
+    let positions = vec![
+        Vec3::new( 0.00,  0.50, 0.0), // tip
+        Vec3::new( 0.50,  0.05, 0.0), // right shoulder
+        Vec3::new( 0.18,  0.05, 0.0), // shaft right top
+        Vec3::new( 0.18, -0.50, 0.0), // shaft right bottom
+        Vec3::new(-0.18, -0.50, 0.0), // shaft left bottom
+        Vec3::new(-0.18,  0.05, 0.0), // shaft left top
+    ];
+    MeshData {
+        positions,
+        normals: vec![Vec3::Z; 6],
+        uvs: vec![Vec2::ZERO; 6],
+        ranges: vec![(0, 12, 0)],
+        indices: vec![
+            0, 1, 2,
+            0, 2, 5,
+            5, 2, 3,
+            5, 3, 4,
+        ],
+        one_sided: false,
     }
 }
 
