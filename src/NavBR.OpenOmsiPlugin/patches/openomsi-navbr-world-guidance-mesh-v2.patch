+fn transform(p: &GroundArrowPrimitive) -> Mat4 {
+    // openOMSI heading: 0 = +Y, clockwise positive. The mesh points along +Y and
+    // glam's +Z rotation is counter-clockwise, hence the negative angle.
+    Mat4::from_rotation_z(-(p.heading_degrees as f32).to_radians())
+        * Mat4::from_scale(Vec3::new(
+            p.width_meters as f32,
+            p.length_meters as f32,
+            1.0,
+        ))
 }
 
 impl WorldGuidance {
+    fn ensure_assets(&mut self, renderer: &Renderer, scene: &mut Scene) -> (MeshId, MaterialId) {
+        let mesh = *self.mesh.get_or_insert_with(|| renderer.add_mesh(scene, &arrow_mesh()));
+        let material = *self.material.get_or_insert_with(|| {
+            // Unlit + alpha blend gives the road-guidance glow without adding a scene
+            // light. Dynamic per-instance alpha applies the distance fade.
+            renderer.add_material(
+                scene,
+                None,
+                AlphaMode::Blend,
+                [0.10, 0.72, 1.00, 0.88],
+                true,
+            )
+        });
+        (mesh, material)
+    }
